# =============================================================================
# PrivateForm - Dockerfile LOCAL (development with hot reload)
# =============================================================================

FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    fonts-dejavu-core \
    libffi-dev \
    libpq-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy Alembic configuration and migrations
COPY alembic.ini ./
COPY migrations/ ./migrations/

# Copy code (will be overridden by volume in docker-compose)
COPY app/ ./app/

# Create logs directory
RUN mkdir -p /app/logs && chmod 750 /app/logs

# Expose port
EXPOSE 8000

#Default command (overridden in docker-compose with --reload)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
